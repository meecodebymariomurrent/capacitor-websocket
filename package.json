{
  "name": "@meecode/capacitor-websocket",
  "version": "1.0.2",
  "description": "Basic websocket for capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "MeecodeCapacitorWebsocket.podspec",
    "LICENSE"
  ],
  "author": "Meecode <mario.murrent@meecode.at>",
  "contributors": [
    "Ryan Cockram <https://github.com/mia-z> (original author)",
    "Martin Loeper <martin.loeper@nesto-software.de>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meecodebymariomurrent/capacitor-websocket.git"
  },
  "bugs": {
    "url": "https://github.com/meecodebymariomurrent/capacitor-websocket/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorWebsocketPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.5.3",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "swiftlint": "^2.0.0",
    "typescript": "~6.0.3"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "packageManager": "yarn@4.18.1",
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/meecodebymariomurrent/capacitor-websocket#readme",
  "publishConfig": {
    "access": "public"
  }
}
